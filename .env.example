# Slack App > OAuth & Permissions 에서 발급한 Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx

# 수집 대상 채널 (채널명 또는 채널 ID 둘 다 가능)
SLACK_CHANNEL=team-sales

# SQLite DB 파일 경로. 기본값은 ~/.analslack/analslack.db (홈 디렉터리, 저장소
# 밖) 이라 생략해도 저장소를 재clone/재설치해도 기존 데이터를 계속 사용합니다.
# 다른 위치에 두고 싶을 때만 지정하세요.
# ANALSLACK_DB_PATH=/path/to/analslack.db

# 주 단위 집계 기준 시간대 (기본값 사용 시 생략 가능)
ANALSLACK_TIMEZONE=Asia/Seoul
